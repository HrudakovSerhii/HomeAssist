# Copy this file to .env.development (and .env.test / .env.production as needed).
# npm scripts load it via dotenv, e.g. `npx dotenv -e .env.development -- ...`

# --- Database (matches docker-compose.db.yml postgres-dev) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/home_ai_assist_dev

# --- Backend ---
BACKEND_PORT=4000
API_PREFIX=api
NODE_ENV=development
# Origin allowed for CORS / WebSocket (the admin.client dev server)
FRONTEND_URL=http://localhost:4200

# --- Security (REQUIRED — backend refuses to start without it) ---
# Key used to encrypt stored IMAP passwords (AES-256-GCM).
# Generate one with: openssl rand -hex 32
APP_PASSWORD_ENCRYPTION_KEY=

# --- Local LLM (Ollama) ---
LLM_OLLAMA_URL=http://localhost:11434
# Optional second Ollama host (target: 'remote')
LLM_OLLAMA_REMOTE_URL=
# Recommended for email processing (see apps/backend.root/src/modules/process-template/LOCAL-LLM-OPTIMIZATION.md):
#   llama3.2:3b (best balance) | gemma2:2b (fastest) | qwen2.5:7b (best reasoning) | mistral:latest (fallback)
LLM_DEFAULT_MODEL=llama3.2:3b

# --- Email processing ---
# Safety cap per schedule execution (default: 5 in development, 1000 otherwise)
PROCESSING_MAX_EMAILS_PER_EXECUTION=5
# How many days back to fetch on the first run of a new account
INITIAL_LOOKBACK_DAYS=7

# --- Frontend (admin.client, read by Vite) ---
# In development the Vite dev server (port 4200) proxies /api and /socket.io
# to the backend on port 4000, so the defaults below are usually fine.
VITE_API_BASE_URL=http://localhost:4200
VITE_API_PREFIX=api
VITE_WS_URL=http://localhost:4200
